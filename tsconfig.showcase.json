{
  "extends": "./tsconfig.json",
  "compilerOptions": { "allowImportingTsExtensions": true },
  "include": [
    "next-env.d.ts",
    "next.config.mts",
    "app/[lang]/(home)/layout.tsx",
    "lib/amamo-source.ts",
    "lib/source.ts",
    "app/[lang]/(home)/showcase/**/*.tsx",
