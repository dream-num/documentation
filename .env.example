NEXT_PUBLIC_SHOWCASES_ORIGIN=https://office.univer.ai

# Public PostHog ingestion key, shared by browser analytics and documentation feedback.
NEXT_POSTHOG_APIKEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Client license for the site's built-in editors; included in the browser bundle.
CLIENT_LICENSE_TEXT=

# Override in .env.local when running the sibling Showcase project locally.
# NEXT_PUBLIC_SHOWCASES_ORIGIN=http://localhost:5180
