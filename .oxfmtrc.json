{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/*.md", "**/*.mdx"],
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "type-builtin",
      { "newlinesBetween": false },
      "builtin",
      { "newlinesBetween": true },
      "type-external",
      { "newlinesBetween": false },
      "external",
      { "newlinesBetween": true },
      ["type-internal", "type-subpath"],
      { "newlinesBetween": false },
      ["internal", "subpath"],
      { "newlinesBetween": true },
      ["type-parent", "type-sibling", "type-index"],
      { "newlinesBetween": false },
      ["parent", "sibling", "index"],
      { "newlinesBetween": true },
      "side_effect_style",
      "side_effect",
      "style",
      "unknown"
    ],
    "internalPattern": ["@/"],
    "newlinesBetween": true
  },
  "sortTailwindcss": {
    "functions": ["clsx"]
  }
}
