{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/*.md", "**/*.mdx", "public/assets/illustrations/hairline-kernel.js"],
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "type-builtin",
      "builtin",
      "type-external",
      "external",
      ["type-internal", "type-subpath"],
      ["internal", "subpath"],
      ["type-parent", "type-sibling", "type-index"],
      ["parent", "sibling", "index"],
      "side_effect_style",
      "side_effect",
      "style",
      "unknown"
    ],
    "internalPattern": ["@/"],
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "functions": ["clsx"]
  }
}
